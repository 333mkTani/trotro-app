# Server
PORT=4000
NGINX_PORT=8080
NODE_ENV=development
CORS_ORIGIN=*

# PostgreSQL (Supabase-compatible). Use the Supabase connection string from
# Project Settings → Database → Connection string (URI). For Supabase use the
# pooled "Transaction" connection on port 6543 in serverless environments.
DATABASE_URL=postgresql://postgres:password@localhost:5432/trotro
PGSSL=false

# Redis 7+ (used for response caching, rate-limiting and bus location pub/sub).
# Leave blank to disable; the app gracefully degrades to passthrough.
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=60
REDIS_PORT=6379

# Auth
JWT_SECRET=replace_with_long_random_string
JWT_EXPIRES_IN=7d

# Optional: Supabase service role for server-side admin actions
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Required when the app authenticates via Supabase Auth — Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=

# Paystack (server-side only — never expose the secret key to any client bundle)
PAYSTACK_SECRET_KEY=

# Mapbox Directions (server-side only; never expose this token in an Expo variable)
MAPBOX_ACCESS_TOKEN=
MAPBOX_DIRECTIONS_BASE_URL=https://api.mapbox.com
ROUTING_CACHE_TTL_SECONDS=30
ROUTING_REQUEST_TIMEOUT_MS=8000
ROUTING_RATE_LIMIT_MAX=30
ROUTING_RATE_LIMIT_WINDOW_MS=60000
MAPBOX_CACHE_TTL_WALKING_SECONDS=120
MAPBOX_CACHE_TTL_DRIVING_SECONDS=30
MAPBOX_CACHE_TTL_TRAFFIC_SECONDS=15
# Keep disabled until driving-traffic behaviour and billing have been validated.
MAPBOX_DRIVING_TRAFFIC_ENABLED=false

# Firebase Admin SDK — service account JSON as a single-line string.
# Used for push notifications (FCM) and to verify Firebase Phone Auth ID
# tokens at registration (see POST /api/auth/register-verified).
FIREBASE_SERVICE_ACCOUNT=
